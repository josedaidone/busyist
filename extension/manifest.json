{
  "manifest_version": 3,
  "name": "Busyist Focus",
  "version": "1.2.1",
  "description": "Blocks distracting websites while a Busyist pomodoro work phase is running, and enforces per-site time limits and blocked hours.",
  "key": "",
  "permissions": ["declarativeNetRequest", "tabs", "alarms", "storage", "idle"],
  "host_permissions": ["http://127.0.0.1:47616/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Busyist Focus" },
  "icons": { "128": "icon.png" },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
